{
  "expo": {
    "name": "sumi",
    "slug": "sumi",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "platforms": [
      "android",
      "web"
    ],
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset"
    ],
    "web": {
      "babel": { "useHermes": false }
    }    
  }
}
